{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.posturenudge",
  "version": "2.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "os.setTray",
    "os.execCommand",
    "window.*",
    "storage.*",
    "events.*",
    "filesystem.move",
    "filesystem.remove"
  ],
  "modes": {
    "window": {
      "title": "Posture",
      "width": 380,
      "height": 120,
      "resizable": false,
      "hidden": true,
      "skipTaskbar": true,
      "borderless": true,
      "transparent": true,
      "alwaysOnTop": true,
      "exitProcessOnClose": false,
      "icon": "/resources/icon.png",
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "Posture",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.3.0",
    "clientVersion": "6.3.0"
  }
}
