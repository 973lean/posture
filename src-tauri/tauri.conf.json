{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus",
  "version": "3.0.0",
  "identifier": "app.posturenudge",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "Focus",
        "width": 800,
        "height": 490,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NzM1MkUwNTE0REI1NDAKUldSQXRVMVI0Rkp6NWp6dWRvckw2NC9INU5HNlFBb3FNOExtZmM5OXdJbmxsU1lYd043dVhWMzgK",
      "endpoints": ["https://github.com/973lean/posture/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
